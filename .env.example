# Copy this file to .env (for the indexer) and to proxy/.env (for the proxy),
# then fill in real values. NEVER commit .env files.

# ── Postgres ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://ela_indexer:CHANGE_ME@127.0.0.1:5432/ela_index?sslmode=disable

# ── Local Elastos.ELA full node JSON-RPC ──────────────────────────────────
# Pull these from your node's config.json (RpcConfiguration.User / Pass).
ELA_NODE_RPC=http://CHANGE_ME_USER:CHANGE_ME_PASS@127.0.0.1:20336
ELA_RPC_USER=CHANGE_ME_USER
ELA_RPC_PASS=CHANGE_ME_PASS
ELA_HOST=127.0.0.1
ELA_PORT=20336

# ── Indexer listen address (private) ──────────────────────────────────────
LISTEN_ADDR=127.0.0.1:8337
INDEXER_HOST=127.0.0.1
INDEXER_PORT=8337

# ── Proxy listen address (front-facing — put behind nginx + TLS) ──────────
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8336

# ── Reference RPC for proposal-title reconciliation (optional) ────────────
REFERENCE_RPC=https://api.elastos.io/ela

# ── Tunables (sane defaults; rarely need to change) ───────────────────────
MAX_BODY=65536
UPSTREAM_TIMEOUT=30000
HEIGHT_POLL_MS=3000

# ── Elastos CR-cycle constants (chain-wide; do not change unless the
#    Elastos main-chain consensus parameters change) ───────────────────────
CR_FIRST_TERM_START=658930
CR_TERM_LENGTH=262800
CR_VOTING_PERIOD=21600
CR_CLAIMING_PERIOD=10080
