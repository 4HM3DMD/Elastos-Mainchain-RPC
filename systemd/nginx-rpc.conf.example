# Example nginx site for terminating TLS in front of the RPC proxy.
# Copy to /etc/nginx/sites-available/ela-rpc, edit server_name + cert paths,
# then `ln -s` into sites-enabled and `systemctl reload nginx`.

server {
    listen 443 ssl http2;
    server_name CHANGE_ME.example.com;

    ssl_certificate     /etc/letsencrypt/live/CHANGE_ME.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/CHANGE_ME.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Basic abuse mitigation
    client_max_body_size 64k;
    limit_req_zone $binary_remote_addr zone=ela_rpc:10m rate=50r/s;

    location = /ela {
        limit_req zone=ela_rpc burst=100 nodelay;

        proxy_pass         http://127.0.0.1:8336/;
        proxy_http_version 1.1;
        proxy_set_header   Host             $host;
        proxy_set_header   X-Real-IP        $remote_addr;
        proxy_set_header   X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    35s;
        proxy_send_timeout    10s;

        add_header Access-Control-Allow-Origin  *  always;
        add_header Access-Control-Allow-Methods 'POST, OPTIONS' always;
        add_header Access-Control-Allow-Headers 'Content-Type'  always;

        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    location / {
        return 404;
    }
}

server {
    listen 80;
    server_name CHANGE_ME.example.com;
    return 301 https://$host$request_uri;
}
